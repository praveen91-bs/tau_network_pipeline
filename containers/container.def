Bootstrap: docker
From: rocker/r-ver:4.3.2

%post
apt-get update && apt-get install -y \
  libxml2-dev \
  libcurl4-openssl-dev \
  libssl-dev \
  libhdf5-dev \
  libgsl-dev \
  libglpk-dev \
  libgit2-dev \
  pandoc \
  build-essential

install.packages(c(
  "Seurat",
  "data.table",
  "Matrix",
  "igraph",
  "future",
  "patchwork"
))

BiocManager::install(c(
  "SingleCellExperiment",
  "SummarizedExperiment",
  "scater",
  "scran",
  "edgeR",
  "limma",
  "WGCNA",
  "GENIE3",
  "SCENIC",
  "AUCell"
))

