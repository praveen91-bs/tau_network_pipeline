// ============================================================================
// Nextflow config — scRNA-seq multiome WGCNA + ML pipeline
// Mac Mini 16GB–optimised (maxForks=1, conservative memory)
// ============================================================================

manifest {
  name        = "scrnaseq-wgcna-ml"
  author      = "Praveen BS"
  description = "Cell-type-specific WGCNA + ML pipeline for scRNA-seq AD"
  version     = "1.0.0"
  mainScript  = "main.nf"
}

// ── Resource defaults ──────────────────────────────────────────────────────
process {
  maxForks  = 1
  executor  = 'local'
  cpus      = 2
  memory    = 8.GB
  time      = 48.h

  withLabel: 'mem_6gb'  { memory = 6.GB }
  withLabel: 'mem_8gb'  { memory = 8.GB }
  withLabel: 'cpus_2'   { cpus   = 2 }
}

// ── Output publishing ─────────────────────────────────────────────────────
// Preserve original output directory structure
publishDir = [
  [
    path: { "${params.outdir}" },
    mode: 'copy',
    pattern: "HIP_processed_filter/**",
    saveAs: { fn -> fn }
  ],
  [
    path: { "${params.outdir}" },
    mode: 'copy',
    pattern: "paper_work/**",
    saveAs: { fn -> fn }
  ]
]

// ── Default params ─────────────────────────────────────────────────────────
params {
  outdir              = "${projectDir}/../sc-multiome"
  h5_dir              = "${params.outdir}/raw_data/multiome_HIP_h5_data"
  frag_dir            = "${params.outdir}/raw_data/multiome_HIP_tsv_files"
  meta_csv            = "${params.outdir}/meta_data/merged_metadata.csv"
  annotations         = "${params.outdir}/meta_data/annotations_hg38.rds"
  macs3_path          = "/Users/praveenbs-270809/miniconda3/envs/macs_env/bin/macs3"
  docker_image        = "scrna-wgcna-ml:latest"
  skip_process_h5     = false
  skip_rna_pseudobulk = false
  skip_atac_pseudobulk= false
  skip_wgcna_ml       = false
}

// ── Docker ─────────────────────────────────────────────────────────────────
docker {
  enabled = false
}

// ── Conda (fallback if Docker not available) ───────────────────────────────
conda {
  createTimeout = '20 min'
}

// ── Environment ────────────────────────────────────────────────────────────
env {
  R_PROFILE_USER = ""
  OMP_NUM_THREADS = "${task.cpus}"
  # Azimuth reference cache
  AZ REFERENCE_DIR = "/opt/azimuth_references"
}

// ── Dag/Debug ──────────────────────────────────────────────────────────────
dag {
  enabled = true
  file    = "pipeline_dag.svg"
}

// ── Timeline & Report ──────────────────────────────────────────────────────
timeline {
  enabled = true
  file    = "pipeline_timeline.html"
}

report {
  enabled = true
  file    = "pipeline_report.html"
}
